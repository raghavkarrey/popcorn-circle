# Optional. A TMDB v3 API key, or a v4 read-access token, searches the full catalog.
# Leave this blank to use the films bundled with the app.
# Create a free key at https://www.themoviedb.org/settings/api
# Restart Expo after changing this file.
EXPO_PUBLIC_TMDB_API_KEY=

# Optional. Where the group server lives. Defaults to http://127.0.0.1:43124,
# which is right for the browser on the same computer.
# On a phone, use your computer's LAN address instead, then restart Expo:
# EXPO_PUBLIC_GROUP_API_URL=http://192.168.1.20:43124
EXPO_PUBLIC_GROUP_API_URL=
