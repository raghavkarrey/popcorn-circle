{
  "expo": {
    "name": "Popcorn Circle",
    "slug": "popcorn-circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "popcorncircle",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0c0f",
    "primaryColor": "#e4a853",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0c0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Popcorn Circle",
      "shortName": "Popcorn",
      "backgroundColor": "#0c0c0f",
      "themeColor": "#0c0c0f",
      "description": "Popcorn Circle. Rate films on your phone, or with friends."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0c0c0f"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    }
  }
}
